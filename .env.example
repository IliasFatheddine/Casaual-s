# MongoDB Atlas connection string (Atlas > Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=casauals
# Gmail account that sends the registration links + its App Password
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Public address of the site (used inside the e-mailed link)
BASE_URL=http://localhost:3000
# Password you type to log in as admin
ADMIN_PASSWORD=change-me
PORT=3000
